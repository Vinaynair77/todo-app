# Copy this file to .env and fill in your values.
# The .env file is git-ignored and loaded automatically by `npm run server`.

# --- Google sign-in (optional) ---
# Create an OAuth 2.0 Client ID (type: Web application) at https://console.cloud.google.com/
# and add this Authorized redirect URI:
#   http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App settings ---
# Where the web app runs. Used to redirect back after Google sign-in.
APP_URL=http://localhost:5173
